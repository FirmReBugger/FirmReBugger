         );
     }
 }
+
+pub struct ReplaySession {
+    emulator: Emulator,
+    snapshot: crate::EmulatorSnapshot,
+}
+
+impl ReplaySession {
+    pub fn create(corpus_path: PathBuf) -> anyhow::Result<Self> {
+        use clap::Parser;
+        let args = cli::Arguments::try_parse_from(vec![
+            "hoedur-dict-arm".to_owned(),
+            "--import-config".to_owned(),
+            corpus_path.to_string_lossy().into_owned(),
+            "run".to_owned(),
+        ])?;
+        let config = RunnerConfig::from_cli(args)?;
+        let RunnerConfig { file_storage, emulator: emulator_config, modeling, .. } = config;
+        let mut emulator = Emulator::new(&file_storage, emulator_config, modeling)
+            .context("Failed to create persistent emulator")?;
+        qemu_rs::set_signal_handler()?;
+        log::info!("Running Hoedur persistent worker initialization ...");
+        emulator.set_next_input_limits(EmulatorLimits::new());
+        let result = emulator
+            .run(InputFile::default(), RunMode::Normal)
+            .context("run emulator with empty input")?;
+        if result.stop_reason != StopReason::EndOfInput {
+            anyhow::bail!("Could not initialize Hoedur replay emulator: {:x?}", result.stop_reason);
+        }
+        emulator.offset_limits();
+        let snapshot = emulator
+            .snapshot_create()
+            .context("Failed to create persistent replay snapshot")?;
+        Ok(Self { emulator, snapshot })
+    }
+
+    pub fn reset(&mut self) -> anyhow::Result<()> {
+        self.emulator.snapshot_restore(&self.snapshot);
+        Ok(())
+    }
+
+    pub fn replay(&mut self, path: &Path) -> anyhow::Result<()> {
+        let result = self
+            .emulator
+            .run(InputFile::read_from_path(path)?, RunMode::Leaf)
+            .context("run Hoedur replay")?;
+        verify_remaining_values(&result);
+        log::info!("Result: {}", result);
+        Ok(())
+    }
+}
