diff --git a/workspace/TS100/src/afl_call.c b/workspace/TS100/src/afl_call.c
new file mode 100644
--- /dev/null
+++ b/workspace/TS100/src/afl_call.c
@@ -0,0 +1,34 @@
+#include <stdint.h>
+
+__attribute__ ((naked)) uint32_t aflCall(
+        __attribute__ ((unused)) uint32_t a0,
+        __attribute__ ((unused)) uint32_t a1,
+        __attribute__ ((unused)) int32_t a2) {
+    __asm__ __volatile__ ("svc $0x3f\n\t"
+                          "bx %lr\n\t");
+}
+
+int startForkserver(int ticks) {
+    return aflCall(1, ticks, 0);
+}
+
+int doneWork(int val) {
+    return aflCall(4, (uint32_t)val, 0);
+}
+
+/*
+ * The checked-in benchmark used this local P2IM compatibility entry point.
+ * It intentionally performs no hypercall; LTO drops the unused AFL helpers.
+ * Blank lines above retain the recovered declaration line in DWARF.
+ */
+
+
+
+
+
+
+
+
+int controlSanitizer(int enable) {
+    return 0;
+}
